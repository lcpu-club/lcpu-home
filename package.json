{
  "name": "lcpu-home",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:default": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --outDir dist/static",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "prettier --write . && eslint . --fix",
    "format": "prettier --write src/",
    "build:client": "vite build --outDir dist/static --ssrManifest",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.ts",
    "build:bundle": "run-p build:client build:server",
    "build:render": "bun ./prerender.ts",
    "build:sitemap": "bun ./sitemap.ts",
    "build:post": "run-p build:render build:sitemap",
    "build:minify": "bun ./minify.ts",
    "build:feed": "bun ./feed.ts",
    "build": "run-s type-check build:bundle build:post build:feed build:minify",
    "wechat": "bun ./scripts/wechat-to-md.ts",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@vueuse/core": "^15.0.0",
    "probe-image-size": "^7.4.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@mdit-vue/plugin-component": "^3.0.2",
    "@mdit-vue/plugin-headers": "^3.0.2",
    "@mdit-vue/plugin-sfc": "^3.0.2",
    "@mdit/plugin-img-lazyload": "^1.1.3",
    "@shikijs/markdown-it": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/probe-image-size": "^7.2.5",
    "@types/serve-static": "^2.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "axios": "^1.20.0",
    "chalk": "^6.0.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "express": "^5.3.0",
    "fast-glob": "^3.3.3",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.3",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-mathjax3": "^5.2.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0",
    "sitemap": "^10.0.0",
    "turndown": "^7.2.4",
    "typescript": "~6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.13",
    "@tsconfig/node24": "^24.0.5",
    "tsx": "^4.23.15",
    "sharp": "^0.35.5",
    "html-minifier-terser": "^7.2.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@playwright/test": "^1.64.1"
  },
  "engines": {
    "node": "24.x",
    "bun": ">=1.4.4"
  }
}
